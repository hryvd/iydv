# Production only: set these in your host's environment settings.
# Run Node 24+ with HTTPS termination and a persistent disk for DATA_DIR.
# NODE_ENV=production
# APP_ORIGIN=https://your-oneup-domain.example
# DATA_DIR=/var/lib/oneup
# PORT=3000
# Only when exactly one trusted reverse proxy is in front of Node:
# TRUST_PROXY=1
